{
  "name": "@quicksilver0218/object-validator",
  "version": "2.1.3",
  "description": "A library providing functions that let users validate the values in objects with JSON-formatted rules.",
  "type": "module",
  "main": "dist",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rimraf dist && node build.ts && tsc",
    "lint": "eslint src/** --fix",
    "test": "jest",
    "test:dist": "npm run build && cross-env TEST_TARGET=dist node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run lint && npm test && npm run test:dist"
  },
  "keywords": [
    "Validation",
    "Object",
    "JSON",
    "Common Rules",
    "Client",
    "Server"
  ],
  "author": {
    "name": "Quicksilver0218"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jest": "^30",
    "rimraf": "^6.1.3",
    "ts-jest": "^29",
    "typescript": "^6",
    "typescript-eslint": "^8.71.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Quicksilver0218/Object-Validator.git"
  },
  "bugs": {
    "url": "https://github.com/Quicksilver0218/Object-Validator/issues"
  },
  "homepage": "https://github.com/Quicksilver0218/Object-Validator#readme",
  "publishConfig": {
    "access": "public"
  }
}
